---
import type { CollectionEntry } from 'astro:content';
import { localizePath, t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'apps'>;
}

const { lang, entry } = Astro.props;
const strings = t(lang);
const slug = entry.id.split('/')[0];
const { name, tagline, icon, status, themeColor } = entry.data;
const released = status === 'released';
const href = localizePath(`/apps/${slug}/`, lang);

const Tag = released ? 'a' : 'div';
---

<Tag
  href={released ? href : undefined}
  class:list={[
    'group flex items-center gap-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition',
    released ? 'hover:-translate-y-0.5 hover:shadow-md' : 'opacity-70',
  ]}
>
  {
    icon ? (
      <img
        src={icon}
        alt=""
        width="64"
        height="64"
        class="h-16 w-16 shrink-0 rounded-2xl border border-slate-100 object-cover"
        loading="lazy"
      />
    ) : (
      <div
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl text-2xl font-bold text-white"
        style={`background:${themeColor}`}
      >
        {name.charAt(0)}
      </div>
    )
  }
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <h3 class="truncate font-semibold text-slate-900">{name}</h3>
      {
        !released && (
          <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">
            {strings.comingSoon}
          </span>
        )
      }
    </div>
    <p class="mt-1 line-clamp-2 text-sm text-slate-500">{tagline}</p>
    {
      released && (
        <span class="mt-2 inline-block text-sm font-medium text-indigo-600 group-hover:underline">
          {strings.viewDetails} →
        </span>
      )
    }
  </div>
</Tag>
