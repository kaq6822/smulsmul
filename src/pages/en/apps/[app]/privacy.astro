---
import LegalPage from '../../../../layouts/LegalPage.astro';
import { legalPaths } from '../../../../lib/routes';

export async function getStaticPaths() {
  return legalPaths('en', 'privacy');
}

const { entry, appEntry } = Astro.props;
const { app } = Astro.params;
---

<LegalPage lang="en" entry={entry} appName={appEntry.data.name} appSlug={app} />
