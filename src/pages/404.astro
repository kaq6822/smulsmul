---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizePath, t } from '../lib/i18n';

const strings = t('ko');
const homeHref = localizePath('/', 'ko');
---

<BaseLayout lang="ko" title={`404 — ${strings.notFoundTitle}`}>
  <div class="mx-auto max-w-3xl px-5 py-24 text-center">
    <p class="text-6xl font-bold text-slate-200">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">
      {strings.notFoundTitle}
    </h1>
    <p class="mt-2 text-slate-500">{strings.notFoundDescription}</p>
    <a
      href={homeHref}
      class="mt-8 inline-block rounded-xl bg-indigo-600 px-6 py-3 font-semibold text-white transition hover:bg-indigo-500"
      >{strings.backToHome}</a
    >
  </div>
</BaseLayout>
