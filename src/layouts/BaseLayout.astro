---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { basePathOf, localizePath, t, withBase, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const strings = t(lang);
const desc = description ?? strings.siteDescription;

const basePath = basePathOf(Astro.url.pathname);
const koUrl = new URL(localizePath(basePath, 'ko'), Astro.site);
const enUrl = new URL(localizePath(basePath, 'en'), Astro.site);
const canonicalUrl = lang === 'ko' ? koUrl : enUrl;
const base = withBase('');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Search Console 소유 확인 (제거 시 인증 해제됨) -->
    <meta
      name="google-site-verification"
      content="qn6mZYSFP-Zhg5lZ02AFKcpN0Nss3ruvbV8g1tWvAX4"
    />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={koUrl} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline define:vars={{ base, pageLang: lang }}>
      // 언어 자동 전환: 사용자가 토글로 선택한 언어(localStorage) > 브라우저 언어.
      // 한국어가 아닌 브라우저는 영어판으로 보낸다. 렌더링 전에 실행되어 깜빡임을 막는다.
      (function () {
        var KEY = 'smulsmul-lang';
        try {
          var stored = localStorage.getItem(KEY);
          var desired =
            stored === 'ko' || stored === 'en'
              ? stored
              : (navigator.language || '').toLowerCase().indexOf('ko') === 0
                ? 'ko'
                : 'en';
          if (desired !== pageLang) {
            var rel = location.pathname.slice(base.length) || '/';
            var target = null;
            if (desired === 'en') {
              // 이미 /en 경로인데 pageLang이 ko인 경우(404 등)는 건드리지 않는다 — 리다이렉트 루프 방지.
              if (rel !== '/en' && rel.indexOf('/en/') !== 0)
                target = base + '/en' + rel;
            } else if (rel === '/en' || rel.indexOf('/en/') === 0) {
              target = base + (rel === '/en' ? '/' : rel.slice(3));
            }
            if (target && target !== location.pathname)
              location.replace(target + location.search + location.hash);
          }
          // 언어 토글 클릭 시 선택을 저장해 이후 방문에서 우선 적용한다.
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest
              ? e.target.closest('[data-set-lang]')
              : null;
            if (a) {
              try {
                localStorage.setItem(KEY, a.getAttribute('data-set-lang'));
              } catch (_) {}
            }
          });
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-white text-slate-800 antialiased flex flex-col">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
