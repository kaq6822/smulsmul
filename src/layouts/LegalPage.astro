---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, localizePath, t, type Lang } from '../lib/i18n';
import { legalDocuments } from '../lib/routes';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'legal'>;
  appName: string;
  appSlug: string;
}

const { lang, entry, appName, appSlug } = Astro.props;
const strings = t(lang);
const { title, effectiveDate, lastUpdated, status } = entry.data;
const { Content } = await render(entry);
const documents = await legalDocuments(appSlug, lang);
---

<BaseLayout lang={lang} title={`${title} — ${appName}`}>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <a
      href={localizePath(`/apps/${appSlug}/`, lang)}
      class="text-sm text-indigo-600 hover:underline">← {strings.backToApp}</a
    >
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900">
      {title}
    </h1>
    <p class="mt-2 text-sm text-slate-500">
      {effectiveDate && <>{strings.effectiveDate}: {formatDate(effectiveDate, lang)}</>}
      {
        lastUpdated && (
          <>
            {effectiveDate ? ' · ' : ''}
            {strings.lastUpdated}: {formatDate(lastUpdated, lang)}
          </>
        )
      }
    </p>
    {status === 'draft' && (
      <aside class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-relaxed text-amber-950">
        <p class="font-semibold">{strings.draft}</p>
        <p class="mt-2">{strings.draftNotice}</p>
      </aside>
    )}
    <nav aria-label={strings.policyNavigation} class="mt-6 flex flex-wrap gap-x-5 gap-y-3 border-y border-slate-100 py-4 text-sm">
      {documents.map((doc) => (
        <a
          href={localizePath(`/apps/${appSlug}/${doc.data.type}/`, lang)}
          aria-current={doc.id === entry.id ? 'page' : undefined}
          class:list={[
            'hover:underline',
            doc.id === entry.id ? 'font-semibold text-slate-900' : 'text-indigo-600',
          ]}
        >{strings[doc.data.type]}</a>
      ))}
      <a href={localizePath(`/apps/${appSlug}/support/`, lang)} class="text-indigo-600 hover:underline">{strings.support}</a>
    </nav>
    <article class="legal-content prose prose-slate mt-8 max-w-none">
      <Content />
    </article>
  </div>
</BaseLayout>
